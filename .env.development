# 开发环境读取配置文件路径
VITE_PUBLIC_PATH = /

# 平台本地运行端口号
VITE_PORT = 2333

# 开发环境日志等级
VITE_LOG_LEVEL = debug

# 处方拆零服务
VITE_PRES_URL = http://192.168.100.201:8126/zoe-split-pres-service

# 收费拆零服务
VITE_CHARGE_URL = http://192.168.100.201:8125/zoe-split-charge-service

# 全局请求头，对应接口文档。requestId 每次请求自动生成
VITE_API_KEY = HIS5
VITE_OPERATOR = 888
VITE_DEPT_CODE = 01
VITE_LANG_TYPE = zh
VITE_ORG_CODE = 2
VITE_DISTRICT_CODE = 1
